7. Two Pointers template
   int left = 0, right = s.length() - 1;
   while (left < right) {
       // compare / swap / move
       left++; right--;
   }

8. Sliding Window template (variable size)
    int left = 0, result = 0;
    for (int right = 0; right < s.length(); right++) {
        // add s.charAt(right) into window
        while (/* window invalid */) {
            // remove s.charAt(left) from window
            left++;
        }
        result = Math.max(result, right - left + 1);
    }

9. Sliding Window template (fixed size k)
   for (int i = 0; i < s.length(); i++) {
       // add s.charAt(i)
       if (i >= k) { /* remove s.charAt(i - k) */ }
       if (i >= k - 1) { /* check/update answer */ }
   }

10. Expand Around Center template (palindromes)
    private int expand(String s, int left, int right) {
        while (left >= 0 && right < s.length() && s.charAt(left) == s.charAt(right)) {
            left--; right++;
        }
        return right - left - 1;   // length of palindrome
    }
    // call with (i, i) for odd length, (i, i+1) for even length

