31. ClimbStair
    class Solution{
     public int climbStairs(int n){
      if(n<=2) return n;
      int a=1,b=2;
      for(int i=3;i<=n;i++){
       int c=a+b; a=b; b=c;
      }
      return b;
     }
    }
32. class Solution{
     public int rob(int[] a){
      int prev=0,curr=0;
      for(int x:a){
       int t=Math.max(curr,prev+x);
       prev=curr; curr=t;
      }
      return curr;
     }
    }
33. CoinChange
    class Solution{
     public int coinChange(int[] c,int amt){
      int[] dp=new int[amt+1];
      java.util.Arrays.fill(dp,amt+1);
      dp[0]=0;
      for(int i=1;i<=amt;i++){
       for(int x:c){
        if(i-x>=0) dp[i]=Math.min(dp[i],dp[i-x]+1);
       }
      }
      return dp[amt]>amt?-1:dp[amt];
     }
    }


34. class Solution{
     public int lengthOfLIS(int[] a){
      int[] d=new int[a.length]; int len=0;
      for(int x:a){
       int i=java.util.Arrays.binarySearch(d,0,len,x);
       if(i<0) i=-(i+1);
       d[i]=x;
       if(i==len) len++;
      }
      return len;
     }
    }
