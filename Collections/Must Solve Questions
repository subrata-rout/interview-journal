    class Solution{
     public int numIslands(char[][] g){
      int c=0;
      for(int i=0;i<g.length;i++)
       for(int j=0;j<g[0].length;j++)
        if(g[i][j]=='1'){dfs(g,i,j);c++;}
      return c;
     }
     void dfs(char[][] g,int i,int j){
      if(i<0||j<0||i>=g.length||j>=g[0].length||g[i][j]=='0')return;
      g[i][j]='0';
      dfs(g,i+1,j);dfs(g,i-1,j);dfs(g,i,j+1);dfs(g,i,j-1);
     }
    }

36. class Solution{
     public int findKthLargest(int[] a,int k){
      java.util.PriorityQueue<Integer> pq=new java.util.PriorityQueue<>();
      for(int x:a){
       pq.add(x);
       if(pq.size()>k) pq.poll();
      }
      return pq.peek();
     }
    }
37. class Solution{
     public int[] topKFrequent(int[] a,int k){
      java.util.Map<Integer,Integer> m=new java.util.HashMap<>();
      for(int x:a) m.put(x,m.getOrDefault(x,0)+1);
      java.util.PriorityQueue<Integer> pq=new java.util.PriorityQueue<>((x,y)->m.get(x)-m.get(y));
      for(int x:m.keySet()){
       pq.add(x);
       if(pq.size()>k) pq.poll();
      }
      int[] r=new int[k];
      for(int i=k-1;i>=0;i--) r[i]=pq.poll();
      return r;
     }
    }
39. class Solution{
     public int[] maxSlidingWindow(int[] a,int k){
      java.util.Deque<Integer> dq=new java.util.ArrayDeque<>();
      int[] r=new int[a.length-k+1]; int idx=0;
      for(int i=0;i<a.length;i++){
       while(!dq.isEmpty()&&dq.peek()<i-k+1) dq.poll();
       while(!dq.isEmpty()&&a[dq.peekLast()]<a[i]) dq.pollLast();
       dq.offer(i);
       if(i>=k-1) r[idx++]=a[dq.peek()];
      }
      return r;
     }
    }

