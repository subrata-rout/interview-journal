 Pattern: Sliding window maximum (Deque/Monotonic queue)
 int[] maxSlidingWindow(int[] nums, int k) {
     Deque<Integer> dq = new ArrayDeque<>(); // stores indices
     int[] res = new int[nums.length - k + 1];
     for (int i = 0; i < nums.length; i++) {
         while (!dq.isEmpty() && dq.peekFirst() <= i - k) dq.pollFirst();
         while (!dq.isEmpty() && nums[dq.peekLast()] < nums[i]) dq.pollLast();
         dq.offerLast(i);
         if (i >= k - 1) res[i - k + 1] = nums[dq.peekFirst()];
     }
     return res;
 }

5. 2D Array Specific Tricks (asked often in matrix problems)
   // Rotate matrix 90° clockwise in-place: transpose + reverse each row
   void rotate(int[][] matrix) {
       int n = matrix.length;
       for (int i = 0; i < n; i++)
           for (int j = i + 1; j < n; j++) {
               int tmp = matrix[i][j]; matrix[i][j] = matrix[j][i]; matrix[j][i] = tmp;
           }
       for (int[] row : matrix) {
           int l = 0, r = row.length - 1;
           while (l < r) { int t = row[l]; row[l++] = row[r]; row[r--] = t; }
       }
   }

   // Spiral traversal
   List<Integer> spiralOrder(int[][] matrix) {
       List<Integer> res = new ArrayList<>();
       int top = 0, bottom = matrix.length - 1, left = 0, right = matrix[0].length - 1;
       while (top <= bottom && left <= right) {
           for (int j = left; j <= right; j++) res.add(matrix[top][j]);
           top++;
           for (int i = top; i <= bottom; i++) res.add(matrix[i][right]);
           right--;
           if (top <= bottom) { for (int j = right; j >= left; j--) res.add(matrix[bottom][j]); bottom--; }
           if (left <= right) { for (int i = bottom; i >= top; i--) res.add(matrix[i][left]); left--; }
       }
       return res;
   }
